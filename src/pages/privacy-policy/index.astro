---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Prose from '../../components/ui/Prose.astro';
import Breadcrumb from '../../components/blog/Breadcrumb.astro';
import siteSettings from '../../content/singletons/site-settings.json';

// POPIA privacy policy — deliberately basic (Grant signed off on a basic policy, 2026-06-18).
// Newsletter deferred until built (no mention here). Analytics = Google Analytics, loaded only
// after opt-in via the cookie-consent banner (see CookieConsent.astro); withdrawable from the
// footer "Cookie settings" link.
const contactEmail = siteSettings.contactEmail;
---

<BaseLayout
  title="Privacy Policy | Grant Booysen"
  description="How Grant Booysen Personal Trainer collects, uses and protects your personal information under POPIA."
>
  <Section tone="paper">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Privacy Policy' }]} />
    <h1 class="mt-6 text-2xl">Privacy Policy</h1>
    <p class="mt-3 text-sm text-muted">Last updated 18 June 2026.</p>

    <Prose class="mt-8">
      <p>
        This policy explains how Grant Booysen Personal Trainer (&ldquo;we&rdquo;,
        &ldquo;us&rdquo;) collects, uses and protects your personal information in line with
        South Africa&rsquo;s Protection of Personal Information Act (POPIA).
      </p>

      <h2>Information we collect</h2>
      <ul>
        <li>
          <strong>Contact form:</strong> your name, email address and the message you send us.
        </li>
        <li>
          <strong>Usage data:</strong> with your consent, we use Google Analytics to understand,
          in aggregate, how visitors use the site. It sets cookies and processes data (such as
          your approximate location, device and the pages you view) on our behalf. It only runs
          if you accept analytics cookies in the banner shown on your first visit — you may
          decline, and you can change your choice at any time via the &ldquo;Cookie settings&rdquo;
          link in the footer.
        </li>
      </ul>

      <h2>How we use your information</h2>
      <ul>
        <li>To respond to your enquiry and provide the coaching services you ask about.</li>
        <li>To understand, in aggregate, how the website is used so we can improve it.</li>
      </ul>
      <p>
        We rely on your <strong>consent</strong> for the contact form. You can withdraw consent
        at any time.
      </p>

      <h2>Who we share it with</h2>
      <p>
        We do not sell your personal information. We share it only with the service providers
        needed to operate the site:
      </p>
      <ul>
        <li>
          <strong>Website hosting &amp; contact form:</strong> Netlify (hosts the site and
          delivers your contact-form message to us).
        </li>
        <li><strong>Analytics:</strong> Google (aggregated website-usage statistics).</li>
      </ul>

      <h2>How long we keep it</h2>
      <p>
        We keep contact enquiries only as long as necessary to deal with your request and for a
        reasonable period afterwards, then delete them.
      </p>

      <h2>Your rights under POPIA</h2>
      <p>You have the right to:</p>
      <ul>
        <li>Ask what personal information we hold about you and request a copy.</li>
        <li>Ask us to correct or delete your information.</li>
        <li>Object to or withdraw consent for our processing.</li>
        <li>
          Lodge a complaint with the Information Regulator of South Africa if you believe your
          rights have been infringed.
        </li>
      </ul>

      <h2>Contact</h2>
      <p>
        For any privacy request or question, email
        <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
      </p>

      <h2>Changes to this policy</h2>
      <p>
        We may update this policy from time to time. The latest version will always be on this
        page with its update date.
      </p>
    </Prose>
  </Section>
</BaseLayout>
