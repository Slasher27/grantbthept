---
// /about/ — the detailed about page (specs/02, new additive route). Content from the
// `about` singleton, structured into sections so it reads scannable, not as a wall.
// Emits Person schema (E-E-A-T) + breadcrumb; reuses the Credentials strip.
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import Breadcrumb from '../../components/blog/Breadcrumb.astro';
import Credentials from '../../components/sections/Credentials.astro';
import { resolveImage } from '../../lib/assets';
import { personNode } from '../../lib/schema';
import about from '../../content/singletons/about.json';

const { profileImage: profilePath = null, profileAlt = '' } = about as typeof about & {
  profileImage?: string | null;
  profileAlt?: string;
};
const profileImage = resolveImage(profilePath);
const introParagraphs = about.intro ? about.intro.split('\n\n') : [];
---

<BaseLayout
  title="About Grant Booysen | Personal Trainer in Cape Town"
  description="Grant Booysen — REPSSA-registered personal trainer and lifestyle coach in Cape Town. His journey, certifications and holistic coaching philosophy."
  schema={[personNode(Astro.site!)]}
>
  <Section tone="paper">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />
    <div class="mt-6 grid items-start gap-10 md:grid-cols-[2fr_3fr] md:gap-16">
      {
        profileImage && (
          <Image
            src={profileImage}
            alt={profileAlt}
            widths={[400, 600, 800]}
            sizes="(min-width: 768px) 40vw, 90vw"
            class="aspect-4/5 w-full rounded-(--radius) object-cover md:sticky md:top-24"
          />
        )
      }
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent-strong">About</p>
        <h1 class="mt-3 text-2xl">Meet Grant Booysen</h1>
        <p class="mt-2 text-sm font-medium text-muted">
          REPSSA-registered personal trainer &amp; lifestyle coach — Cape Town, South Africa.
        </p>

        {introParagraphs.map((p) => <p class="mt-6 text-lg leading-relaxed text-ink/90">{p}</p>)}

        {
          about.sections.map((s) => (
            <div class="mt-10">
              <h2 class="text-lg font-bold">{s.heading}</h2>
              <div class="mt-4 flex flex-col gap-5 text-base text-muted">
                {s.body.split('\n\n').map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <Credentials />

  <Section tone="dark" class="text-center">
    <h2 class="text-xl">Ready to start your journey?</h2>
    <p class="mx-auto mt-4 max-w-md text-paper/80">
      Train with me in Cape Town or get coached remotely — let&rsquo;s find what works for you.
    </p>
    <Button href="/#contact" variant="accent" class="mt-8">Contact Me</Button>
  </Section>
</BaseLayout>
