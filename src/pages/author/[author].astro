---
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import { getCollection } from 'astro:content';
import { author } from '../../lib/author';

// Single author for now → /author/grantbooysen/. See specs/02.
export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((p) => !p.data.draft);
  const authors = [...new Set(posts.map((p) => p.data.author))];
  return authors.map((a) => ({
    params: { author: a },
    props: {
      posts: posts
        .filter((p) => p.data.author === a)
        .sort((x, y) => y.data.pubDate.getTime() - x.data.pubDate.getTime()),
    },
  }));
}

const { posts } = Astro.props;
---

<ArchiveLayout
  title={`${author.name} | Grant Booysen`}
  description={`Articles by ${author.name}, a REPSSA-registered personal trainer and lifestyle coach in Cape Town.`}
  heading={author.name}
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Latest News', href: '/news/' }, { label: author.name }]}
  intro={author.bio}
  posts={posts}
/>
