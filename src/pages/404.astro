---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="Page not found | Grant Booysen"
  description="The page you were looking for could not be found."
>
  <Section tone="paper" class="text-center">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">Error 404</p>
    <h1 class="mt-3 text-2xl">This page can&rsquo;t be found</h1>
    <p class="mx-auto mt-4 max-w-md text-muted">
      The page may have moved or no longer exists. Try one of these instead.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <Button href="/" variant="accent">Go home</Button>
      <Button href="/news/" variant="outline">Latest News</Button>
      <Button href="/#services" variant="outline">Services</Button>
    </div>
  </Section>
</BaseLayout>
