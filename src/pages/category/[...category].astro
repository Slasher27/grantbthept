---
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import { getCollection } from 'astro:content';
import { categories, getCategory } from '../../lib/categories';

// One route for flat and nested categories alike — the category slug is a PATH
// (e.g. 'plans/eating' → /category/plans/eating/), captured by the rest param.
// See specs/02.
export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((p) => !p.data.draft);
  return categories.map((cat) => ({
    params: { category: cat.slug },
    props: {
      category: cat,
      posts: posts
        .filter((p) => p.data.categories.includes(cat.slug))
        .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
    },
  }));
}

const { category, posts } = Astro.props;
const label = category.name;

// Breadcrumb reflects the nested path: plans/eating → Home › Latest News › Plans ›
// Eating Plans, with each ancestor linking to its own archive.
const parts = category.slug.split('/');
const crumbs: { label: string; href?: string }[] = [
  { label: 'Home', href: '/' },
  { label: 'Latest News', href: '/news/' },
];
let acc = '';
parts.forEach((part, i) => {
  acc = acc ? `${acc}/${part}` : part;
  const name = getCategory(acc)?.name ?? part;
  crumbs.push(i === parts.length - 1 ? { label: name } : { label: name, href: `/category/${acc}/` });
});
---

<ArchiveLayout
  title={`${label} | Grant Booysen`}
  description={`Articles about ${label.toLowerCase()} from Cape Town personal trainer Grant Booysen.`}
  heading={label}
  breadcrumb={crumbs}
  posts={posts}
/>
