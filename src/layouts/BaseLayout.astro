---
// The document shell: head (BaseHead + self-hosted fonts), skip link, global
// header/footer chrome, and the single <main> landmark. Pages supply inner content.
import '../styles/global.css';
import { Font } from 'astro:assets';
import BaseHead from '../components/layout/BaseHead.astro';
import Schema from '../components/layout/Schema.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: unknown[];
}

const {
  title = 'Grant Booysen Personal Trainer',
  description =
    'Personal training, lifestyle coaching and corporate wellness in Cape Town with Grant Booysen, REPSSA-registered personal trainer.',
  image,
  type,
  schema,
} = Astro.props;
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <BaseHead title={title} description={description} image={image} type={type} />
    <Font cssVariable="--font-poppins" preload />
    {schema && <Schema graph={schema} />}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
