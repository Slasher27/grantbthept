---
// Minimal base layout — the single place global.css is imported (specs/04).
// Head/meta, fonts, CSP and real chrome (Header/Footer) land in Phase 3.
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Grant Booysen PT' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
