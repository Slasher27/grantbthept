---
// Dark site footer: wordmark + tagline, nav, social, auto-year copyright (specs/07).
// Facts come from the siteSettings singleton (single source).
import Container from '../ui/Container.astro';
import { navLinks } from '../../lib/nav';
import siteSettings from '../../content/singletons/site-settings.json';

const { name, tagline, social } = siteSettings;
const year = new Date().getFullYear();

// Minimal inline icons keyed by platform; unknown platforms fall back to a text label.
const icons: Record<string, string> = {
  Instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>',
  Facebook:
    '<path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V9H6.5v3H9v9h3v-9h2.5l.5-3H12V6.5a.5.5 0 0 1 .5-.5H15V3z"/>',
};
---

<footer class="bg-dark text-paper">
  <Container>
    <div class="grid gap-10 py-16 md:grid-cols-[2fr_1fr_1fr]">
      <div>
        <p class="text-lg font-bold">Grant Booysen</p>
        <p class="mt-3 max-w-sm text-sm text-paper/70">{tagline}</p>
      </div>

      <nav aria-label="Footer">
        <ul class="space-y-2 text-sm">
          {
            navLinks.map((l) => (
              <li>
                <a href={l.href} class="text-paper/80 hover:text-accent">
                  {l.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/privacy-policy/" class="text-paper/80 hover:text-accent">Privacy Policy</a>
          </li>
        </ul>
      </nav>

      <div>
        <p class="text-sm font-semibold">Follow</p>
        <ul class="mt-3 flex gap-3">
          {
            social.map((s) => (
              <li>
                <a
                  href={s.url}
                  aria-label={s.platform}
                  rel="me noopener"
                  class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-[var(--radius)] text-paper/80 hover:text-accent"
                >
                  {icons[s.platform] ? (
                    <svg
                      aria-hidden="true"
                      width="22"
                      height="22"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      set:html={icons[s.platform]}
                    />
                  ) : (
                    <span class="text-sm">{s.platform}</span>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 py-6 text-xs text-paper/60">
      <p>&copy; {year} {name}. All rights reserved.</p>
    </div>
  </Container>
</footer>
