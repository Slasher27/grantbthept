---
// Star rating with a text accessible name (never colour alone — specs/06).
interface Props {
  rating: number;
  class?: string;
}
const { rating, class: className } = Astro.props;
---

<div class:list={['flex items-center gap-0.5', className]} aria-label={`Rated ${rating} out of 5`}>
  {
    Array.from({ length: 5 }).map((_, i) => (
      <svg
        aria-hidden="true"
        class={i < rating ? 'text-accent' : 'text-line'}
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path d="M12 2l2.9 6.3 6.9.7-5.1 4.7 1.4 6.8L12 17.8 5.9 21.2l1.4-6.8L2.2 9.7l6.9-.7L12 2z" />
      </svg>
    ))
  }
</div>
