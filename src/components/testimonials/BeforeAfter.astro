---
// Labelled before/after image pair — equal crop, never distorted (specs/07).
// A static pair (no slider) keeps it zero-JS and fully accessible. Used on the
// testimonial card and detail page; caller controls size via widths/sizes.
// Portrait 4:5 crop suits full-body transformation shots — upload matched 1080×1350 pairs.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  name: string;
  alt?: string;
  widths?: number[];
  sizes?: string;
}
const {
  before,
  after,
  name,
  alt,
  widths = [256, 384, 512],
  sizes = '(min-width: 768px) 220px, 45vw',
} = Astro.props;
---

<div class="grid grid-cols-2">
  <figure class="relative m-0">
    <Image
      src={before}
      alt={alt ? `Before — ${alt}` : `${name} before training`}
      widths={widths}
      sizes={sizes}
      class="aspect-[4/5] w-full object-cover"
    />
    <figcaption class="absolute left-2 top-2 rounded bg-ink/80 px-2 py-0.5 text-xs font-semibold text-paper">
      Before
    </figcaption>
  </figure>
  <figure class="relative m-0">
    <Image
      src={after}
      alt={alt ? `After — ${alt}` : `${name} after training`}
      widths={widths}
      sizes={sizes}
      class="aspect-[4/5] w-full object-cover"
    />
    <figcaption class="absolute left-2 top-2 rounded bg-accent px-2 py-0.5 text-xs font-semibold text-accent-ink">
      After
    </figcaption>
  </figure>
</div>
