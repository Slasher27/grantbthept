---
// Breadcrumb trail for blog pages (specs/07). The last item is the current page.
// Emits its own BreadcrumbList JSON-LD from the same items it renders, so the visible
// trail and the schema can never drift — one per page (specs/05).
import Schema from '../layout/Schema.astro';
import { breadcrumbNode } from '../../lib/schema';
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;

// The current (last) crumb has no href in the UI; point its schema item at this page.
const schemaItems = items.map((c, i) => ({
  name: c.label,
  item: c.href ?? (i === items.length - 1 ? Astro.url.pathname : undefined),
}));
---

<nav aria-label="Breadcrumb" class="text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-2">
    {
      items.map((c, i) => (
        <li class="flex items-center gap-2">
          {c.href ? (
            <a href={c.href} class="hover:text-accent">
              {c.label}
            </a>
          ) : (
            <span aria-current="page" class="text-ink">
              {c.label}
            </span>
          )}
          {i < items.length - 1 && <span aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>
<Schema graph={[breadcrumbNode(Astro.site!, schemaItems)]} />
