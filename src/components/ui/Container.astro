---
// Centred content column at the shared max-width with consistent gutters.
// The single place `--container` is applied (specs/04).
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['mx-auto w-full max-w-[var(--container)] px-6 md:px-8', className]}>
  <slot />
</div>
