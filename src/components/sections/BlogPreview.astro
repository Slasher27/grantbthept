---
// Blog preview: the three most-recent published posts → "Latest News" (specs/07).
import { getCollection } from 'astro:content';
import Section from '../ui/Section.astro';
import PostCard from '../blog/PostCard.astro';

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<Section tone="paper" labelledby="news-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent-strong">Latest News</p>
      <h2 id="news-heading" class="mt-3 text-xl">Articles &amp; insights</h2>
    </div>
    <a href="/news/" class="text-sm font-semibold text-ink hover:text-accent">View all articles &rarr;</a>
  </div>

  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</Section>
