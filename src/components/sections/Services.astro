---
// Services section (#services): three offerings from the services singleton.
// Service schema is added in the structured-data pass. Card images are optional —
// rendered only once the assets exist.
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import { contactCta } from '../../lib/nav';
import { resolveImage } from '../../lib/assets';
import services from '../../content/singletons/services.json';

// Keystatic drops empty optional fields on save, so `image` may be absent per item.
const items = services.items.map((s) => ({
  ...s,
  img: resolveImage((s as { image?: string | null }).image),
}));
---

<Section id="services" tone="light" labelledby="services-heading">
  <div class="max-w-2xl">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent-strong">Services</p>
    <h2 id="services-heading" class="mt-3 text-xl">How I can help you</h2>
  </div>

  <div class="mt-12 grid gap-6 md:grid-cols-3">
    {
      items.map((s) => (
        <Card class="flex flex-col p-6 md:p-8">
          {s.img && (
            <Image
              src={s.img}
              alt=""
              widths={[400, 600, 800]}
              sizes="(min-width: 768px) 30vw, 90vw"
              class="mb-6 aspect-3/2 w-full rounded-(--radius) object-cover"
            />
          )}
          <h3 class="text-lg font-bold">{s.title}</h3>
          <p class="mt-3 text-sm text-muted">{s.blurb}</p>
          <ul class="mt-5 flex flex-col gap-3 text-sm">
            {s.bullets.map((b) => (
              <li class="flex gap-3">
                <svg
                  aria-hidden="true"
                  class="mt-1 shrink-0 text-accent"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>
          <Button href={contactCta.href} variant="outline" class="mt-8 self-start">
            {s.ctaLabel}
          </Button>
        </Card>
      ))
    }
  </div>
</Section>
