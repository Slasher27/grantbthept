---
// Credentials strip from the credentials singleton. Each item renders its logo when
// uploaded, falling back to a styled wordmark of the name. Logos resolved via lib/assets.
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import { resolveImage } from '../../lib/assets';
import credentials from '../../content/singletons/credentials.json';

// Keystatic drops empty optional fields on save, so `logo`/`link` may be absent per item.
const items = credentials.items.map((c) => {
  const item = c as typeof c & { logo?: string | null; link?: string | null };
  return { ...item, img: resolveImage(item.logo) };
});
---

<Section tone="light" labelledby="credentials-heading">
  <p id="credentials-heading" class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-muted">
    Trained &amp; certified with
  </p>
  <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
    {
      items.map((c) => (
        <li class="text-sm font-bold uppercase tracking-wide text-muted">
          {c.link ? (
            <a href={c.link} rel="noopener" class="block hover:text-accent">
              {c.img ? <Image src={c.img} alt={c.alt} class="h-10 w-auto object-contain" /> : c.name}
            </a>
          ) : c.img ? (
            <Image src={c.img} alt={c.alt} class="h-10 w-auto object-contain" />
          ) : (
            c.name
          )}
        </li>
      ))
    }
  </ul>
</Section>
