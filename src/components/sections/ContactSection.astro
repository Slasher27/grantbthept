---
// Contact section (#contact): accessible form + details (specs/07).
// DEMO WIRING: posts to Netlify Forms (data-netlify) with a honeypot — zero backend,
// works on the Netlify demo. The spec's launch path is an Astro endpoint → Resend with
// Altcha (specs/01); swap the form handler then. POPIA consent is required either way.
// Phone is intentionally not published. Only confirmed details (email, hours, area) show.
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import siteSettings from '../../content/singletons/site-settings.json';

const { contactEmail, openingHours } = siteSettings;
// Display string derived from the structured hours (same source as the schema's
// openingHoursSpecification, so they can't drift). "06:00" → "6am", contiguous days → range.
const fmtTime = (t: string) => {
  const [h, m] = t.split(':').map(Number);
  const period = h < 12 ? 'am' : 'pm';
  const h12 = h % 12 || 12;
  return m ? `${h12}:${String(m).padStart(2, '0')}${period}` : `${h12}${period}`;
};
const { days } = openingHours;
const hoursDisplay = `${days[0]} – ${days[days.length - 1]}: ${fmtTime(openingHours.opens)} – ${fmtTime(openingHours.closes)}`;

const fieldClass =
  'w-full rounded-[var(--radius)] border border-line bg-paper px-4 py-3 text-ink placeholder:text-muted';
const labelClass = 'mb-2 block text-sm font-medium text-paper';
---

<Section id="contact" tone="dark" labelledby="contact-heading">
  <div class="grid gap-10 md:grid-cols-2 md:gap-16">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">Contact</p>
      <h2 id="contact-heading" class="mt-3 text-xl">Ready to start?</h2>
      <p class="mt-5 max-w-md text-paper/80">
        Tell me about your goals and I&rsquo;ll get back to you about training in Cape Town or
        remote coaching.
      </p>

      <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="mt-8 grid gap-5">
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>Don&rsquo;t fill this out if you&rsquo;re human: <input name="bot-field" /></label>
        </p>

        <div>
          <label for="name" class={labelClass}>Name</label>
          <input id="name" name="name" type="text" required autocomplete="name" class={fieldClass} />
        </div>
        <div>
          <label for="email" class={labelClass}>Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" class={fieldClass} />
        </div>
        <div>
          <label for="subject" class={labelClass}>Subject</label>
          <input id="subject" name="subject" type="text" class={fieldClass} />
        </div>
        <div>
          <label for="message" class={labelClass}>Message</label>
          <textarea id="message" name="message" rows="5" required class={fieldClass}></textarea>
        </div>

        <label class="flex items-start gap-3 text-sm text-paper/80">
          <input type="checkbox" name="consent" required class="mt-1 accent-accent" />
          <span>
            I agree to my details being used to respond to my enquiry, as described in the
            <a href="/privacy-policy/" class="text-paper underline decoration-accent underline-offset-2 hover:text-accent">privacy policy</a>.
          </span>
        </label>

        <Button type="submit" variant="accent" class="justify-self-start">Send message</Button>
      </form>

      <div
        data-form-success
        hidden
        tabindex="-1"
        role="status"
        aria-live="polite"
        class="mt-8 flex items-start gap-3 rounded-(--radius) border border-paper/20 bg-paper/5 p-6 text-paper"
      >
        <svg
          aria-hidden="true"
          class="mt-0.5 shrink-0 text-accent"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20 6 9 17l-5-5" />
        </svg>
        <p>Thanks &mdash; your message has been sent. I&rsquo;ll be in touch soon.</p>
      </div>

      <p data-form-error hidden role="alert" class="mt-4 text-sm text-paper/90">
        Something went wrong sending your message. Please email
        <a
          href={`mailto:${contactEmail}`}
          class="underline decoration-accent underline-offset-2 hover:text-accent"
          >{contactEmail}</a
        > directly.
      </p>
    </div>

    <dl class="grid gap-6 self-start text-sm md:pt-10">
      <div>
        <dt class="font-semibold text-paper">Email</dt>
        <dd class="mt-1">
          <a href={`mailto:${contactEmail}`} class="text-paper/80 hover:text-accent">{contactEmail}</a>
        </dd>
      </div>
      <div>
        <dt class="font-semibold text-paper">Hours</dt>
        <dd class="mt-1 text-paper/80">{hoursDisplay}</dd>
      </div>
      <div>
        <dt class="font-semibold text-paper">Location</dt>
        <dd class="mt-1 text-paper/80">Cape Town, South Africa</dd>
      </div>
    </dl>
  </div>
</Section>

<script>
  // Submit the contact form to Netlify Forms via fetch so the visitor stays on the page
  // and sees an inline, on-brand confirmation (announced via the success panel's
  // aria-live). Native `required`/email validation runs first (submit only fires when
  // valid). With no JS, the form falls back to a normal POST → Netlify's default page.
  const form = document.querySelector<HTMLFormElement>('form[name="contact"]');
  const success = document.querySelector<HTMLElement>('[data-form-success]');
  const error = document.querySelector<HTMLElement>('[data-form-error]');
  if (form && success && error) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.hidden = true;
      const params = new URLSearchParams();
      for (const [key, value] of new FormData(form).entries()) params.append(key, String(value));
      try {
        const res = await fetch(location.pathname, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: params.toString(),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.hidden = true;
        success.hidden = false;
        success.focus();
      } catch {
        error.hidden = false;
      }
    });
  }
</script>
