---
// Homepage About teaser (#about-me): a short summary + photo linking to the full
// /about/ story. The detailed bio lives in the `about` singleton and renders on /about/.
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import about from '../../content/singletons/about.json';
import { resolveImage } from '../../lib/assets';

// Keystatic omits empty optional fields when it saves, so these may be absent from the JSON.
const { profileImage: profilePath = null, profileAlt = '' } = about as typeof about & {
  profileImage?: string | null;
  profileAlt?: string;
};
const profileImage = resolveImage(profilePath);
---

<Section id="about-me" tone="paper" labelledby="about-heading">
  <div
    class:list={[
      profileImage ? 'grid items-center gap-10 md:grid-cols-[2fr_3fr] md:gap-16' : 'mx-auto max-w-3xl',
    ]}
  >
    {
      profileImage && (
        <Image
          src={profileImage}
          alt={profileAlt}
          widths={[400, 600, 800]}
          sizes="(min-width: 768px) 40vw, 90vw"
          class="aspect-4/5 w-full rounded-(--radius) object-cover"
        />
      )
    }
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent-strong">About</p>
      <h2 id="about-heading" class="mt-3 text-xl">Meet Grant Booysen</h2>
      <p class="mt-2 text-sm font-medium text-muted">
        REPSSA-registered personal trainer &amp; lifestyle coach — Cape Town, South Africa.
      </p>
      <p class="mt-6 text-lg leading-relaxed text-ink/90">{about.summary}</p>
      <Button href="/about/" class="mt-8">Read my full story</Button>
    </div>
  </div>
</Section>
